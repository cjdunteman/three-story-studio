---
const year = new Date().getFullYear();
const links = [
	{ href: "/", label: "Home" },
	{ href: "/gallery", label: "Gallery" },
	{ href: "/about", label: "About" },
];
const social = [
	{
		href: "https://www.linkedin.com/in/kristin-dunteman-1197aa72/",
		src: "/icons/linkedin.svg",
		alt: "LinkedIn",
	},
	{
		href: "https://www.instagram.com/threestorystudio/",
		src: "/icons/instagram.svg",
		alt: "instagram",
	},
	{
		href: "https://www.facebook.com/3storystudiollc",
		src: "/icons/facebook.svg",
		alt: "facebook",
	},
];
---

<footer class="bg-gradient-to-b from-taupe-light to-taupe px-8 py-12">
	<div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-8">
		<div>
			<img
				src="/3SS_logo_transparent.png"
				alt="Three Story Studio Logo"
				width="200"
				height="60"
				class="mb-4"
			/>
		</div>
		<div>
			<h2 class="text-2xl md:text-3xl font-bold mb-4">Quick Links</h2>
			<ul class="space-y-3">
				{
					links.map((link) => (
						<li>
							<a href={link.href} class="text-xl md:text-2xl underline-offset-4 hover:underline">
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
		<div>
			<h2 class="text-2xl md:text-3xl font-bold mb-4">Contact</h2>
			<p class="text-xl md:text-2xl mb-4">
				Reach out directly to discuss your upholstery project with me!
			</p>
			<div class="mt-6">
				<a
					href="mailto:kristin@threestorystudio.com"
					class="brand-button px-4 py-3 rounded text-xl md:text-2xl"
				>
					Send an Email
				</a>
			</div>
			<div class="flex space-x-4 mt-8">
				{
					social.map((item) => (
						<a href={item.href} target="_blank" rel="noopener noreferrer">
							<img src={item.src} height="32" width="32" alt={item.alt} />
						</a>
					))
				}
			</div>
		</div>
	</div>
	<hr class="my-8 border-line" />
	<div class="text-center mt-8 text-ink">
		<p class="text-lg md:text-xl">&copy; {year} Three Story Studio. All rights reserved.</p>
	</div>
</footer>
