---
import { getEmDashEntry } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { additionalPhotos, loadProject, projectPath } from "../../lib/content";

const slug = Astro.params.slug;
if (!slug) return Astro.rewrite("/404");

const { entry: piece, cacheHint } = await getEmDashEntry("pieces", slug);
if (cacheHint && Astro.cache?.enabled) Astro.cache.set(cacheHint);
if (!piece) return Astro.rewrite("/404");

const photos = additionalPhotos(piece.data);
if (photos.length === 0) return Astro.rewrite("/404");

const showcase = piece.data.showcase?.id ? piece.data.showcase : undefined;

function photoStyle(image: { width?: number; height?: number } | null | undefined) {
	const width = image?.width;
	const height = image?.height;
	if (!width || !height) return undefined;
	const ratio = Math.round((width / height) * 10000) / 10000;
	return `--piece-ratio: ${ratio}`;
}
const description = typeof piece.data.description === "string" ? piece.data.description.trim() : "";
const projectSlug = typeof piece.data.project_slug === "string" ? piece.data.project_slug.trim() : "";
let projectTitle = "";
let projectHref = "";

if (projectPath(projectSlug)) {
	const projectResult = await loadProject(projectSlug);
	if (projectResult.cacheHint && Astro.cache?.enabled) Astro.cache.set(projectResult.cacheHint);
	if (projectResult.entry) {
		projectTitle = projectResult.entry.data.title;
		projectHref = `/projects/${projectResult.entry.id}`;
	}
}
---

<Base title={`${piece.data.title} — Three Story Studio`} description={description || undefined}>
	<article class="pb-20">
		<header class="mx-auto max-w-3xl px-6 md:px-10">
			<p class="mb-8 text-xl">
				{
					projectHref && (
						<a href={projectHref} class="underline decoration-1 underline-offset-4">
							{projectTitle}
						</a>
					)
				}
			</p>
			<h1 class="font-script mb-6 text-4xl leading-tight md:text-6xl" {...piece.edit.title}>
				{piece.data.title}
			</h1>
			{
				description && (
					<p class="max-w-3xl text-xl whitespace-pre-line md:text-2xl" {...piece.edit.description}>
						{description}
					</p>
				)
			}
		</header>
		<div class="piece-photos" {...piece.edit.photos}>
			{
				showcase && (
					<figure style={photoStyle(showcase)} {...piece.edit.showcase}>
						<Image
							image={showcase}
							alt={showcase.alt || piece.data.title}
							sizes="(min-width: 64rem) 32rem, 100vw"
							priority
							loading="eager"
							fetchpriority="high"
						/>
						{showcase.caption && <figcaption class="text-lg">{showcase.caption}</figcaption>}
					</figure>
				)
			}
			{
				photos.map((photo, index) => {
					const caption = photo.caption || photo.image.caption?.trim() || "";
					const first = !showcase && index === 0;
					return (
						<figure style={photoStyle(photo.image)}>
							<Image
								image={photo.image}
								alt={photo.image.alt || caption || piece.data.title}
								sizes="(min-width: 64rem) 32rem, 100vw"
								priority={first}
								loading={first ? "eager" : "lazy"}
								fetchpriority={first ? "high" : undefined}
							/>
							{caption && <figcaption class="text-lg">{caption}</figcaption>}
						</figure>
					);
				})
			}
		</div>
	</article>
</Base>
