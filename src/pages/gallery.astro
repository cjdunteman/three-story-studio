---
import { Image } from "emdash/ui";
import PieceLink from "../components/PieceLink.astro";
import Base from "../layouts/Base.astro";
import { loadPieces, piecePagePath, projectPath } from "../lib/content";

const { entries, cacheHints, error } = await loadPieces();
for (const hint of cacheHints) {
	if (Astro.cache?.enabled) Astro.cache.set(hint);
}

const pieces = error ? [] : entries.filter((entry) => entry.data.showcase?.id);
---

<Base title="Gallery — Three Story Studio">
	<div class="container mx-auto columns-1 sm:columns-2 lg:columns-4 gap-8 max-w-6xl px-10 mb-12">
		{
			pieces.map((piece, index) => {
				const image = piece.data.showcase;
				const width = image?.width;
				const height = image?.height;
				const href = piecePagePath(piece) || projectPath(piece.data.project_slug);
				const frame = {
					class: "cover-frame mb-4 break-inside-avoid relative [content-visibility:auto] [contain-intrinsic-size:480px]",
					style: width && height ? `aspect-ratio: ${width} / ${height}` : undefined,
				};
				const photo = (
					<Image
						image={image}
						priority={index === 0}
						loading={index < 4 ? "eager" : "lazy"}
						fetchpriority={index === 0 ? "high" : undefined}
						sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
						class="object-cover"
						alt={image?.alt || piece.data.title}
					/>
				);
				return href ? (
					<div {...frame}>
						<PieceLink href={href} class="h-full">
							{photo}
						</PieceLink>
					</div>
				) : (
					<div {...frame}>{photo}</div>
				);
			})
		}
	</div>
	{
		pieces.length === 0 && (
			<p class="max-w-3xl mx-auto px-10 pb-16 text-xl">Pieces show up here once they are published with a showcase image.</p>
		)
	}
</Base>
