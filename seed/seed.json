{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "Three Story Studio",
		"description": "Custom upholstery and soft goods for your home.",
		"author": "Three Story Studio"
	},
	"settings": {
		"title": "Three Story Studio",
		"tagline": "Custom upholstery and soft goods for your home.",
		"url": "https://www.threestorystudio.com"
	},
	"collections": [
		{
			"slug": "projects",
			"label": "Projects",
			"labelSingular": "Project",
			"titleField": "title",
			"urlPattern": "/projects/{slug}",
			"supports": ["drafts", "revisions", "seo"],
			"fields": [
				{
					"slug": "title",
					"label": "Name",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "legacy_id",
					"label": "Previous project id",
					"type": "string",
					"indexed": true
				}
			]
		},
		{
			"slug": "pieces",
			"label": "Pieces",
			"labelSingular": "Piece",
			"titleField": "title",
			"urlPattern": "/pieces/{slug}",
			"supports": ["drafts", "revisions", "search"],
			"fields": [
				{
					"slug": "title",
					"label": "Name",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "description",
					"label": "Description",
					"type": "text",
					"searchable": true
				},
				{
					"slug": "showcase",
					"label": "Showcase",
					"type": "image",
					"required": true
				},
				{
					"slug": "photos",
					"label": "More photos",
					"type": "repeater",
					"validation": {
						"subFields": [
							{ "slug": "image", "label": "Photo", "type": "image", "required": true },
							{ "slug": "caption", "label": "Caption", "type": "string" }
						]
					}
				},
				{
					"slug": "show_on_home",
					"label": "Home page slideshow",
					"type": "boolean",
					"indexed": true
				},
				{
					"slug": "finished_piece",
					"label": "Finished piece",
					"type": "boolean",
					"indexed": true
				},
				{
					"slug": "project_slug",
					"label": "Project slug",
					"type": "string",
					"indexed": true
				}
			]
		}
	],
	"taxonomies": [
		{
			"name": "category",
			"label": "Categories",
			"labelSingular": "Category",
			"hierarchical": true,
			"collections": ["pieces"],
			"terms": [
				{ "slug": "cushions-pillows", "label": "Cushions & Pillows" }
			]
		}
	],
	"menus": [
		{
			"name": "primary",
			"label": "Primary Navigation",
			"items": [
				{ "type": "custom", "label": "Home", "url": "/" },
				{ "type": "custom", "label": "Gallery", "url": "/gallery" },
				{ "type": "custom", "label": "About", "url": "/about" }
			]
		}
	]
}
