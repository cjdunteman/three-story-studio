# Public origin. Set this on Vercel so admin passkeys match the browser.
SITE_URL=https://www.threestorystudio.com

# Postgres. DATABASE_URL is preferred. DATABASE_URI is the old Payload name and still works.
# On Vercel, use the Supabase transaction pooler (port 6543).
DATABASE_URL=
# DATABASE_SSL=false

# S3-compatible media. Same names the Payload project already uses.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_URL=

# Required for admin login on Vercel. An Upstash Redis URL works.
# Leave unset for local dev, which uses an in-memory session store.
REDIS_URL=
