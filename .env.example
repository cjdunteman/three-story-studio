# Public origin. On Cloudflare, set this as a Worker variable before setup
# so passkeys and login redirects match the browser:
#   npx wrangler secret put EMDASH_SITE_URL
# Do not bake the production origin into astro.config.mjs.
EMDASH_SITE_URL=https://www.threestorystudio.com

# Encrypts plugin settings stored by EmDash. Generate one with:
#   npx emdash secrets generate
# Then set the same value in production:
#   npx wrangler secret put EMDASH_ENCRYPTION_KEY
EMDASH_ENCRYPTION_KEY=
